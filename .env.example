# Copia este archivo a .env y cambia los valores

# Usuario y contraseña para el panel de administración (donde subes las fotos)
ADMIN_USER=julian
ADMIN_PASS=cambia_esto_123

# Secreto para las sesiones (pon cualquier cadena larga aleatoria)
SESSION_SECRET=cambia_esto_por_algo_largo_y_aleatorio

# Puerto (Railway lo asigna automáticamente, esto es para local)
PORT=3000

# URL base de tu app cuando esté desplegada (para generar el QR correctamente)
# En local puedes dejarlo como está
BASE_URL=http://localhost:3000
