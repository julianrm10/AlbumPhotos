<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= album.name %> - Álbum de fotos</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-dark bg-dark px-3">
    <span class="navbar-brand">📸 <%= album.name %></span>
  </nav>

  <div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
      <p class="text-muted mb-0"><%= images.length %> foto(s)</p>
      <% if (images.length > 0) { %>
        <a href="/album/<%= album.code %>/download" class="btn btn-dark">⬇ Descargar todo (ZIP)</a>
      <% } %>
    </div>

    <% if (images.length === 0) { %>
      <p class="text-muted">Todavía no hay fotos en este álbum.</p>
    <% } else { %>
      <div class="gallery-grid">
        <% images.forEach(img => { %>
          <a href="/uploads/<%= album.code %>/<%= img.filename %>" download="<%= img.original_name %>" target="_blank">
            <img src="/uploads/<%= album.code %>/<%= img.filename %>" alt="" loading="lazy">
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>
</body>
</html>
