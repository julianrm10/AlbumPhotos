<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= album.name %> - FotoÁlbum</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-dark bg-dark px-3">
    <a href="/admin" class="navbar-brand text-white text-decoration-none">← Mis álbumes</a>
    <a href="/logout" class="btn btn-outline-light btn-sm">Cerrar sesión</a>
  </nav>

  <div class="container py-4">
    <h4><%= album.name %></h4>

    <div class="row g-4 mb-4">
      <div class="col-md-8">
        <div class="card shadow-sm">
          <div class="card-body">
            <h6>Compartir con tus amigas</h6>
            <div class="input-group mb-2">
              <input type="text" class="form-control" readonly value="<%= baseUrl %>/album/<%= album.code %>" id="albumLink">
              <button class="btn btn-outline-secondary" onclick="copiarEnlace()">Copiar</button>
            </div>
            <a href="/album/<%= album.code %>" target="_blank" class="btn btn-sm btn-dark">Abrir galería pública</a>
          </div>
        </div>
      </div>
      <div class="col-md-4 text-center">
        <div class="qr-box">
          <img src="/album/<%= album.code %>/qr" alt="QR del álbum" width="150">
        </div>
        <p class="small text-muted mt-1">Escanea para compartir</p>
      </div>
    </div>

    <div class="card shadow-sm mb-4">
      <div class="card-body">
        <h6>Subir fotos</h6>
        <form method="POST" action="/admin/albums/<%= album.id %>/upload" enctype="multipart/form-data" class="d-flex gap-2 flex-wrap">
          <input type="file" name="photos" accept="image/*" multiple class="form-control" required style="max-width: 400px;">
          <button type="submit" class="btn btn-dark">Subir</button>
        </form>
        <p class="text-muted small mt-2 mb-0">Puedes seleccionar varias fotos a la vez (máx. 15MB por foto).</p>
      </div>
    </div>

    <h6>Fotos en este álbum (<%= images.length %>)</h6>
    <div class="gallery-grid">
      <% images.forEach(img => { %>
        <div class="position-relative">
          <img src="/uploads/<%= album.code %>/<%= img.filename %>" alt="">
          <form method="POST" action="/admin/albums/<%= album.id %>/images/<%= img.id %>/delete"
                onsubmit="return confirm('¿Eliminar esta foto?')"
                class="position-absolute top-0 end-0 m-1">
            <button class="btn btn-sm btn-danger py-0 px-1">✕</button>
          </form>
        </div>
      <% }) %>
    </div>
  </div>

  <script>
    function copiarEnlace() {
      const input = document.getElementById('albumLink');
      input.select();
      navigator.clipboard.writeText(input.value);
      alert('Enlace copiado');
    }
  </script>
</body>
</html>
